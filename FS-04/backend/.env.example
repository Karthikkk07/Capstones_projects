# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database / Redis ---
DATABASE_URL=postgresql://pm:pm@localhost:5432/pm?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Required (non-default) when NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# --- URLs ---
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Used for Stripe success/cancel/return URLs
APP_URL=http://localhost:5173

# --- Stripe (test mode) ---
# Leave empty to run without billing; checkout/portal then return 503
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Attachments ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
