NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://lms:lms@localhost:5432/lms?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Video pipeline (local fallback: files are served from /media)
UPLOAD_DIR=uploads
MEDIA_DIR=media
MAX_UPLOAD_MB=500
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Absolute base URL of the API used to build local playback URLs (leave empty when frontend proxies /media)
PUBLIC_API_URL=

# Optional: S3 + CloudFront delivery (see README)
S3_BUCKET=
S3_REGION=us-east-1
KEEP_LOCAL_AFTER_S3=false
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
# PEM private key; newlines may be written as \n
CLOUDFRONT_PRIVATE_KEY=
CLOUDFRONT_SIGN_MODE=cookies
CLOUDFRONT_COOKIE_DOMAIN=
CLOUDFRONT_URL_TTL_SECONDS=3600

# LiveKit (matches `livekit-server --dev`)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecret12
LIVEKIT_URL=ws://localhost:7880

# Stripe test mode (optional - checkout returns 503 when missing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
INSTRUCTOR_SHARE_PCT=80
